# ---------------------------------------------------------------------------
# irodori-c — C inference engine
# ---------------------------------------------------------------------------

# Build outputs
*.o
/irodori
/irodori_asan
/irodori-blas
/irodori-mkl
/irodori-mkl.bin
/irodori-onemkl
/irodori-bench-worker
/irodori-bench-worker-mkl
/irodori-bench-worker-mkl.bin
/irodori-bench-worker-onemkl
/irodori-baseline-*
/.irodori-*

# Model assets and golden fixtures (downloaded/exported locally; see README)
/weights/
/golden/

# Local benchmark scratch
/.bench-*
/.profile-*
/downloads/

# Evaluation artifacts: keep reports, tables, figures, JSON summaries and
# source diffs; drop audio, raw tensors, binaries, logs and archives.
/artifacts/**/*.wav
/artifacts/**/*.f32
/artifacts/**/*.bin
/artifacts/**/*.tar.gz
/artifacts/**/*.err
/artifacts/**/*.stderr
/artifacts/**/*.bak
/artifacts/**/*.sha256
/artifacts/**/dump/
/artifacts/**/baseline/*
!/artifacts/**/baseline/*.txt
!/artifacts/**/baseline/*.diff
/artifacts/**/bench-codec-*
/artifacts/**/test-mkl-local
/artifacts/**/onemkl-runtime/

# Audio written by tests and examples
*.wav

# Local agent context and working notes (never published)
/HANDOFF_*.md
/OPTIMIZATION_PLAN*.md
/PERFORMANCE.md
/AGENT.md
/AGENTS.md
/CLAUDE.md
/CODEX.md
/docs/

# Python caches (tools/)
__pycache__/
*.py[cod]

# Editor and OS files
*.swp
*~
.DS_Store
