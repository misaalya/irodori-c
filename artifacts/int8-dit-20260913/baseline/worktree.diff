+		-o /tmp/irodori-bench-onemkl-packed
+	MKL_CBWR=AVX2 taskset -c 0,1 /tmp/irodori-bench-onemkl-packed \
+		"$(MODEL)" "$(BACKBONE_GOLDEN)/dit_b0_mlp_adaln_h.f32"
 
