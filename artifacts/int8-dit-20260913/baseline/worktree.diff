+
+int iro_dit_profile_enabled(void) {
+    if (dit_profile_state < 0) {
+        const char *env = getenv("IRO_DIT_PROFILE");
+        dit_profile_state = env && strcmp(env, "0") != 0;
+    }
+    return dit_profile_state;
